{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to Docker (ts-node)",
      "port": 9229,
      "address": "localhost",
      "restart": true,
      "localRoot": "${workspaceFolder}/src",
      "remoteRoot": "/app/src",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    }
  ]
}
